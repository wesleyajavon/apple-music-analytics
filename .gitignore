# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/
.turbo

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (NEVER commit these - contain API keys and secrets)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/migrations
/prisma/migrationsSaved

# generated (Prisma generated files - auto-generated, don't commit)
/generated*

# local settings
.vscode/

# Documentation interne (optionnel - décommenter si vous ne voulez pas committer)
# docs/internal/CODE_REVIEW.md

# Generated TypeDoc output (npm run docs:generate) - keep markdown guides
/docs/*.html
/docs/**/*.html
/docs/assets/
/docs/modules/
/docs/classes/
/docs/interfaces/

# Generated API docs copied to public during build (npm run docs:api:copy)
/public/docs/

# Cache and IDE
.cache/
.cursor/

# Logs
*.log
