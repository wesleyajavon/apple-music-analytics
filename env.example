# ============================================
# Apple Music Analytics - Variables d'environnement
# ============================================
# 
# Copiez ce fichier vers .env.local pour le développement local
# ou configurez ces variables dans votre plateforme de déploiement (Vercel, etc.)

# ============================================
# BASE DE DONNÉES
# ============================================

# Log des requêtes Prisma (dev uniquement):
# - non défini ou "compact" = une ligne par requête (recommandé)
# - "full" = SQL complet (débogage)
# - "false" ou "0" = désactivé
# PRISMA_LOG_QUERIES=compact

# Pour le développement local (PostgreSQL standard)
DATABASE_URL="postgresql://user:password@localhost:5432/apple_music_analytics"

# ============================================
# SUPABASE AUTH (Nouveau - requis pour multi-utilisateur)
# ============================================
#
# Créez un projet Supabase et activez Auth.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = clé "publishable/anon" du projet.
#
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Clé serveur pour autoriser les imports script/admin
# Envoyée via header: x-import-admin-key
# ⚠️ Ne jamais exposer côté client (pas de NEXT_PUBLIC_)
IMPORT_ADMIN_KEY="change_me_strong_random_secret"

# Clé admin dédiée (optionnelle) pour les endpoints d'observabilité rate-limit.
# Si absente, le serveur réutilise IMPORT_ADMIN_KEY comme fallback.
# Header accepté: x-admin-key (ou x-import-admin-key en compatibilité).
# RATE_LIMIT_ADMIN_KEY="change_me_another_strong_secret"
#
# Endpoints admin disponibles:
# - GET /api/admin/rate-limit/top-blocked?route=/api/overview&limit=10
# - GET /api/admin/rate-limit/overview?perRouteTopLimit=5
#   (optionnel: &routes=/api/overview,/api/timeline)
# - GET /api/admin/rate-limit/health
#   (optionnel: &warnThreshold=10&criticalThreshold=20)

# Pour la production sur Vercel (créé automatiquement si vous utilisez Vercel Postgres)
# ⚠️ IMPORTANT: Utilisez POSTGRES_PRISMA_URL pour l'application (avec pooler)
POSTGRES_PRISMA_URL="postgres://default:xxx@xxx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Pour les migrations Prisma en production (sans pooler)
# ⚠️ IMPORTANT: Utilisez POSTGRES_URL_NON_POOLING uniquement pour les migrations
POSTGRES_URL_NON_POOLING="postgres://default:xxx@xxx.pooler.supabase.com:5432/postgres"

# ============================================
# LAST.FM API (Optionnel)
# ============================================
# 
# Pour activer l'intégration Last.fm réelle:
# 1. Créez un compte sur https://www.last.fm/api/account/create
# 2. Créez une application API
# 3. Copiez votre API Key et Secret ici
#
# Si ces variables ne sont pas définies, l'application utilisera des données mockées.

LASTFM_API_KEY="votre_lastfm_api_key"
LASTFM_API_SECRET="votre_lastfm_api_secret"

# ============================================
# REDIS (Optionnel - pour le cache)
# ============================================
# 
# Pour activer le cache Redis (recommandé pour améliorer les performances):
# 1. Créez un compte sur Upstash (https://upstash.com) - gratuit jusqu'à 10k requêtes/jour
# 2. Créez une base de données Redis
# 3. Copiez l'URL Redis ici
# 
# OU pour le développement local:
# - Installez Redis: brew install redis (macOS) ou sudo apt install redis-server (Linux)
# - Utilisez: REDIS_URL="redis://localhost:6379/0"
#
# Si cette variable n'est pas définie, le cache Redis sera désactivé.

REDIS_URL="redis://default:xxxxx@xxxxx.upstash.io:6379"

# Seuil d'alerte de pic 429 (compteur par route et par minute).
# Quand atteint/dépassé, un signal dédié est envoyé à Sentry + log error.
# RATE_LIMIT_SPIKE_ALERT_THRESHOLD=20

# ============================================
# SENTRY (Optionnel - pour le monitoring d'erreurs)
# ============================================
# 
# Pour activer le monitoring d'erreurs avec Sentry:
# 1. Créez un compte sur https://sentry.io (plan gratuit disponible)
# 2. Créez un nouveau projet Next.js
# 3. Copiez votre DSN (Data Source Name) ici
#
# SENTRY_DSN est utilisé côté serveur
# NEXT_PUBLIC_SENTRY_DSN est utilisé côté client
# 
# En production, vous pouvez utiliser la même valeur pour les deux.
# Si non défini, le monitoring d'erreurs sera désactivé.

SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"

# ============================================
# GROQ (Optionnel - pour AI Insights)
# ============================================
#
# Pour activer les insights IA générés à partir de vos analytics:
# 1. Créez un compte sur https://console.groq.com (tier gratuit disponible)
# 2. Générez une clé API
# 3. Définissez GROQ_API_KEY ici
#
# Si non défini, la page AI Insights affichera une erreur explicite.

GROQ_API_KEY="gsk_..."

# ============================================
# GEMINI DESIGN MCP (Optionnel - pour Cursor IDE)
# ============================================
# 
# Pour activer Gemini Design MCP dans Cursor IDE:
# 1. Créez un compte sur https://gemini-design-mcp.com
# 2. Générez une clé API depuis le dashboard (gratuit : 10K tokens/mois)
# 3. Définissez cette variable d'environnement système
#
# Note: Cette variable doit être définie dans votre environnement système
# (pas seulement dans .env.local) car elle est utilisée par la configuration
# Cursor dans ~/.cursor/mcp.json
#
# Sur macOS/Linux, ajoutez dans ~/.zshrc ou ~/.bashrc:
# export GEMINI_DESIGN_API_KEY="votre_clé_api_ici"
#
# Puis rechargez le shell: source ~/.zshrc
#
# Sur Windows, définissez via les Paramètres système > Variables d'environnement

GEMINI_DESIGN_API_KEY="gd_votre_clé_api_ici"

# IDs utilisateurs Supabase autorisés pour les vues admin/debug en production.
# Format CSV:
# NEXT_PUBLIC_ADMIN_USER_IDS="uuid_user_1,uuid_user_2"

# Palette suggestions externes (safe mode):
# - false (défaut): suggestions internes uniquement
# - true: active le point d'extension provider externe (jamais auto-apply)
PALETTE_EXTERNAL_SUGGESTIONS_ENABLED="false"
