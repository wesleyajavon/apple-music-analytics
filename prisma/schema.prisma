// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id // Must match Supabase auth.users.id
  email     String?  @unique
  name      String?
  avatarUrl String?
  /// Set when the user finishes the first-login data-export onboarding flow.
  onboardingCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listens       Listen[]
  replayYearly  ReplayYearly[]
  paletteDecisions PaletteArtistDecision[]
  paletteTrackDecisions PaletteTrackDecision[]
  importGenreBackfillJobs ImportGenreBackfillJob[]
  paletteSuggestions PaletteSuggestion[]
  paletteSuggestionDecisions PaletteSuggestionDecision[]
  spotifyConnection SpotifyConnection?
  consents UserConsent[]
  friendshipsAsRequester Friendship[] @relation("FriendshipRequester")
  friendshipsAsAddressee Friendship[] @relation("FriendshipAddressee")
  duetShareSettings DuetShareSettings?
}

/// GDPR consent audit trail (cookies, terms, IA, etc.)
model UserConsent {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousId    String?
  consentType    String
  consentVersion String
  granted        Boolean
  categories     Json?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([userId, consentType, createdAt])
  @@index([anonymousId, consentType, createdAt])
}

/// OAuth Spotify (Web API) — tokens chiffrés au repos ; Option A Supabase provider.
model SpotifyConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotifyUserId         String
  spotifyDisplayName    String?
  spotifyEmail          String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  scope                 String
  tokenType             String    @default("Bearer")
  expiresAt             DateTime
  syncCursorMs          BigInt?
  lastSyncedAt          DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([spotifyUserId])
  @@index([userId, revokedAt])
}

model Artist {
  id        String   @id @default(cuid())
  name      String   @unique
  nameLower String   @unique // Lowercase version for case-insensitive searches
  mbid      String?  @unique // MusicBrainz ID
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks              Track[]
  replayTopArtists    ReplayTopArtist[]
  paletteDecisions    PaletteArtistDecision[]
  paletteSuggestions  PaletteSuggestion[]

  @@index([nameLower])
  @@index([mbid])
}

enum PaletteDecisionStatus {
  mapped
  skipped
}

enum ImportGenreBackfillJobStatus {
  pending
  running
  completed
  failed
  paused
  cancelled
}

enum PaletteSuggestionMode {
  artists
  tracks
}

enum PaletteSuggestionDecisionType {
  accepted
  edited
  rejected
}

enum FriendshipStatus {
  pending
  accepted
  declined
  blocked
}

enum DuetShareScope {
  none
  aggregates
  full
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(pending)
  shareScope  DuetShareScope   @default(none)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model DuetShareSettings {
  userId              String         @id
  allowFriendRequests Boolean        @default(true)
  defaultShareScope   DuetShareScope @default(aggregates)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaletteArtistDecision {
  id                  String                @id @default(cuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId            String
  artist              Artist                @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artistName          String
  status              PaletteDecisionStatus
  genre               String?
  unknownListensRemoved Int                 @default(0)
  impactedTracks      Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([userId, artistId])
  @@index([userId, status])
  @@index([artistId])
}

model PaletteTrackDecision {
  id                    String                @id @default(cuid())
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId               String
  track                 Track                 @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackTitle            String
  artistName            String
  status                PaletteDecisionStatus
  genre                 String?
  unknownListensRemoved Int                   @default(0)
  impactedTracks      Int                     @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([userId, trackId])
  @@index([userId, status])
  @@index([trackId])
}

model Track {
  id        String   @id @default(cuid())
  title     String
  titleLower String  // Lowercase version for case-insensitive searches
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  mbid      String?  @unique // MusicBrainz ID
  duration  Int?     // Duration in seconds
  genre     String?  // Genre musical (from Last.fm API)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listens             Listen[]
  replayTopTracks     ReplayTopTrack[]
  paletteTrackDecisions PaletteTrackDecision[]
  paletteSuggestions  PaletteSuggestion[]

  @@unique([title, artistId], name: "unique_title_artist")
  @@index([artistId])
  @@index([titleLower])
  @@index([mbid])
  @@index([genre])
}

model Listen {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playedAt  DateTime // Timestamp of when the track was played
  source    String   @default("lastfm") // lastfm | apple_music_replay | spotify_export | spotify_web_api | apple_music_export
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([trackId])
  @@index([playedAt])
  @@index([userId, playedAt])
  @@index([userId, trackId])
}

model ReplayYearly {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year            Int      // Year (e.g., 2024)
  totalPlayTime   Int      // Total play time in seconds
  totalPlays      Int      // Total number of plays
  importedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  topArtists  ReplayTopArtist[]
  topTracks   ReplayTopTrack[]
  topAlbums   ReplayTopAlbum[]

  @@unique([userId, year])
  @@index([userId])
  @@index([year])
}

model ReplayTopArtist {
  id            String        @id @default(cuid())
  replayYearlyId String
  replayYearly  ReplayYearly  @relation(fields: [replayYearlyId], references: [id], onDelete: Cascade)
  artistId      String
  artist        Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  rank          Int           // Position in top list (1, 2, 3, ...)
  playCount     Int           // Number of plays for this artist
  createdAt     DateTime      @default(now())

  @@unique([replayYearlyId, rank])
  @@index([replayYearlyId])
  @@index([artistId])
}

model ReplayTopTrack {
  id            String        @id @default(cuid())
  replayYearlyId String
  replayYearly  ReplayYearly  @relation(fields: [replayYearlyId], references: [id], onDelete: Cascade)
  trackId       String
  track         Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  rank          Int           // Position in top list (1, 2, 3, ...)
  playCount     Int           // Number of plays for this track
  createdAt     DateTime      @default(now())

  @@unique([replayYearlyId, rank])
  @@index([replayYearlyId])
  @@index([trackId])
}

model ReplayTopAlbum {
  id            String        @id @default(cuid())
  replayYearlyId String
  replayYearly  ReplayYearly  @relation(fields: [replayYearlyId], references: [id], onDelete: Cascade)
  albumName     String        // Album name (no separate Album model for now)
  artistName    String        // Artist name for the album
  rank          Int           // Position in top list (1, 2, 3, ...)
  playCount     Int           // Number of plays for this album
  createdAt     DateTime      @default(now())

  @@unique([replayYearlyId, rank])
  @@index([replayYearlyId])
}

model ImportGenreBackfillJob {
  id               String                     @id @default(cuid())
  userId           String
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String                     @default("groq")
  status           ImportGenreBackfillJobStatus @default(pending)
  targetUnknownPct Float                      @default(15)
  delayMs          Int                        @default(300)
  maxApiRequests   Int                        @default(250)
  maxArtists       Int                        @default(200)
  apiRequestsUsed  Int                        @default(0)
  artistsProcessed Int                        @default(0)
  artistsMapped    Int                        @default(0)
  tracksUpdated    Int                        @default(0)
  initialUnknownPct Float?
  currentUnknownPct Float?
  errorMessage     String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaletteSuggestion {
  id                     String               @id @default(cuid())
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode                   PaletteSuggestionMode
  artistId               String?
  artist                 Artist?              @relation(fields: [artistId], references: [id], onDelete: Cascade)
  trackId                String?
  track                  Track?               @relation(fields: [trackId], references: [id], onDelete: Cascade)
  provider               String
  suggestedGenreRaw      String
  suggestedGenreNormalized String
  confidence             Float                @default(0.5)
  evidence               Json?
  createdAt              DateTime             @default(now())
  decisions              PaletteSuggestionDecision[]

  @@index([userId, mode, createdAt])
  @@index([artistId, createdAt])
  @@index([trackId, createdAt])
}

model PaletteSuggestionDecision {
  id            String                        @id @default(cuid())
  suggestionId  String
  suggestion    PaletteSuggestion             @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId        String
  user          User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision      PaletteSuggestionDecisionType
  finalGenre    String?
  createdAt     DateTime                      @default(now())

  @@index([userId, createdAt])
  @@index([suggestionId, createdAt])
}